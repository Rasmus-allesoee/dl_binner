"""Independent arms, serial four-core/26-GB cap; all ready rules are measured."""
import json
from pathlib import Path
PLAN = str(Path(config['plan']).absolute())
P = json.loads(Path(PLAN).read_text())
PYTHON, WORKER = P['python'], P['worker']
ENGINEERING = '--engineering' if config.get('engineering') in [True, 'true'] else ''

rule all:
    input: ['reference/done.json'] + ['units/'+u+'/audit/done.json' for u in P['units']]

rule oral_reference:
    output: 'reference/done.json'
    priority: 100
    threads: 4
    resources: mem_mb=26000
    log: 'logs/oral-reference.log'
    benchmark: 'benchmarks/oral-reference.tsv'
    shell: '{PYTHON:q} -I -B {WORKER:q} --plan {PLAN:q} --reference {ENGINEERING} > {log:q} 2>&1'

rule E009_noGLM_admit:
