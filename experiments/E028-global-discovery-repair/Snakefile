"""Six retrieval barriers before frozen E027 bin selection; no learning rules."""
import json
from pathlib import Path
import shlex
P=json.loads(Path(config['plan']).read_text())
ENG=str(config.get('engineering','false')).lower()=='true'
FLAG=' --engineering' if ENG else ''
q=lambda x:shlex.quote(str(x))
BASE=q(P['python'])+' -I -B '+q(P['worker'])+' --plan '+q(config['plan'])+FLAG
rule all:
    input: [u+'/audit/done.json' for u in ['E009-noGLM','E009-GLM','oral-noGLM']]

rule E009_noGLM_teacher_retrieve:
    output: 'retrieval/E009-noGLM/teacher/done.json'
    log: 'logs/E009-noGLM-teacher-retrieve.log'
    benchmark: 'benchmarks/E009-noGLM-teacher-retrieve.tsv'
    threads: 4
    resources: mem_mb=26000
    priority: 100
    shell: BASE+' --unit E009-noGLM --role teacher --stage retrieve > {log} 2>&1'

rule E009_noGLM_student_retrieve:
    input: ['retrieval/E009-noGLM/teacher/done.json']
