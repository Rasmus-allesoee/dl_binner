"""Two serial cached-input positive-only fits; no preparation, detector or baseline jobs."""
import json
from pathlib import Path
PLAN=str(Path(config['plan']).absolute())
P=json.loads(Path(PLAN).read_text())
UNITS=list(P['units'])
PYTHON=P['python']
WORKER=P['worker']

rule all:
    input: expand('units/{unit}/graph-proof.json',unit=UNITS)

def previous_unit(w):
    i=UNITS.index(w.unit)
    return ['units/'+UNITS[i-1]+'/graph-proof.json'] if i else []

rule train:
    input: previous_unit
    output: 'units/{unit}/train/checkpoint.json'
    threads: 4
    log: 'logs/{unit}/train.log'
    benchmark: 'benchmarks/{unit}/train.tsv'
    shell: '{PYTHON:q} -I -B {WORKER:q} --plan {PLAN:q} --unit {wildcards.unit:q} --stage train > {log:q} 2>&1'

rule embed:
    input: 'units/{unit}/train/checkpoint.json'
    output: 'units/{unit}/embeddings.json'
    threads: 4
    log: 'logs/{unit}/embed.log'
    benchmark: 'benchmarks/{unit}/embed.tsv'
    shell: '{PYTHON:q} -I -B {WORKER:q} --plan {PLAN:q} --unit {wildcards.unit:q} --stage embed > {log:q} 2>&1'

rule group:
    input: 'units/{unit}/embeddings.json'
    output: 'units/{unit}/group/partition.json'
    threads: 4
    log: 'logs/{unit}/group.log'
    benchmark: 'benchmarks/{unit}/group.tsv'
    shell: '{PYTHON:q} -I -B {WORKER:q} --plan {PLAN:q} --unit {wildcards.unit:q} --stage group > {log:q} 2>&1'

rule refine:
    input: 'units/{unit}/group/partition.json'
    output: 'units/{unit}/refine/completed.json'
    threads: 4
    log: 'logs/{unit}/refine.log'
    benchmark: 'benchmarks/{unit}/refine.tsv'
    shell: '{PYTHON:q} -I -B {WORKER:q} --plan {PLAN:q} --unit {wildcards.unit:q} --stage refine > {log:q} 2>&1'

rule export:
    input: 'units/{unit}/refine/completed.json'
    output: 'units/{unit}/export/accounting.json'
    threads: 4
    log: 'logs/{unit}/export.log'
    benchmark: 'benchmarks/{unit}/export.tsv'
    shell: '{PYTHON:q} -I -B {WORKER:q} --plan {PLAN:q} --unit {wildcards.unit:q} --stage export > {log:q} 2>&1'

rule graph_proof:
    input: 'units/{unit}/export/accounting.json'
    output: 'units/{unit}/graph-proof.json'
    threads: 4
    log: 'logs/{unit}/graph-proof.log'
    benchmark: 'benchmarks/{unit}/graph-proof.tsv'
    shell: '{PYTHON:q} -I -B {WORKER:q} --plan {PLAN:q} --unit {wildcards.unit:q} --stage graph-proof > {log:q} 2>&1'
