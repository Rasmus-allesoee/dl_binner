"""A serial milestone chain that probe-created scientific caches cannot bypass."""
import json
from pathlib import Path
p=json.loads(Path(config['plan']).read_text())
engineering=' --engineering'if config.get('engineering')=='true'else''
worker=str(Path(p['worker']).with_name('e036_dispatch.py'))

def previous(w):
    n=int(w.ordinal)
    if not 0<=n<=30:raise ValueError('Unknown serial dispatch position')
    return [] if n==0 else ['dispatch/%03d.json'%(n-1)]

rule all:
    input:'dispatch/030.json'

rule dispatch:
    input:previous
    output:'dispatch/{ordinal}.json'
    wildcard_constraints:ordinal='[0-9]{3}'
    threads:4
    resources:mem_mb=26000
    benchmark:'benchmarks/dispatch-{ordinal}.tsv'
    shell:p['python']+' -I -B '+worker+' --plan '+config['plan']+' --ordinal {wildcards.ordinal}'+engineering
