"""Explicit serial barriers and isolated tensor/graph workers."""
import json
from pathlib import Path
P=json.loads(Path(config['plan']).read_text())
ENG=' --engineering' if str(config.get('engineering','false')).lower()=='true' else ''
plan_path=Path(config['plan']);python=P['python'];worker=P['worker']

rule all:
    input: 'oral-noGLM/audit/done.json'

rule barrier:
    output: 'barrier/done.json'
    threads: 4
    resources: mem_mb=26000
    log: 'logs/barrier.log'
    benchmark: 'benchmarks/barrier.tsv'
    shell: '{python:q} -I -B {worker:q} --plan {plan_path:q}{ENG} --stage barrier > {log:q} 2>&1'

